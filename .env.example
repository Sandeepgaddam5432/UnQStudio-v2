# =============================================================================
# Brand & White-Label Configuration (100% Env-Driven — Zero Hardcoded Domains)
# Copy this file to `.env.local` for local development or set in your static host
# (Cloudflare Pages, Vercel, Netlify, GitHub Pages, Capacitor Android build).
# =============================================================================

VITE_APP_NAME="My AI Studio"
VITE_APP_SHORT_NAME="AI Studio"
VITE_APP_TAGLINE="Build, refine & ship software with autonomous AI."
VITE_APP_DESCRIPTION="Browser-native AI IDE with Rules, Skills, Specs, Context Management, MCP & Sub-agents."
VITE_APP_URL="https://app.example.com"
VITE_APP_DOMAIN="app.example.com"
VITE_APP_STORAGE_PREFIX="studio"
VITE_APP_LOGO_URL="/brand-logo.svg"
VITE_APP_SUPPORT_EMAIL=""
VITE_APP_REPO_URL=""
VITE_APP_DOCS_URL=""

# =============================================================================
# Optional Infrastructure Endpoints (App works 100% statically even when empty)
# =============================================================================
# Optional CORS proxy for browser Git push/clone & deploy APIs:
# Example: https://proxy.example.com/?url={href}
VITE_CORS_PROXY_URL=""

# Optional isolated wildcard preview host (leave empty for built-in static sandbox preview)
# Example: preview.example.com
VITE_PREVIEW_DOMAIN=""

# Optional favicon resolver template:
# Example: https://favicon.example.com/?url={href}
VITE_FAVICON_URL=""

# ESM CDN used by the in-browser esbuild bundler
VITE_ESM_URL="https://esm.sh"

# Optional custom OpenAI-compatible AI provider preset
VITE_DEFAULT_AI_NAME=""
VITE_DEFAULT_AI_API_URL=""

# =============================================================================
# Optional OAuth Client IDs (PKCE / Public Client — never bundle secrets!)
# =============================================================================
VITE_GITHUB_OAUTH_CLIENT_ID=""
VITE_NETLIFY_OAUTH_CLIENT_ID=""
VITE_VERCEL_OAUTH_CLIENT_ID=""

# =============================================================================
# Optional Observability
# =============================================================================
VITE_SENTRY_DSN=""
VITE_PLAUSIBLE_DOMAIN=""
VITE_PLAUSIBLE_ENDPOINT=""

# =============================================================================
# Mobile / Capacitor Android Build Variables (read by capacitor.config.ts & Gradle)
# =============================================================================
APP_ID="com.example.aistudio"
APP_NAME="My AI Studio"
APP_DOMAIN="app.example.com"
